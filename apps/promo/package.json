{
  "name": "claimtrace-promo",
  "private": true,
  "version": "0.1.0",
  "description": "One-take promo film for ClaimTrace, built with Remotion from real UI screenshots.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "NODE_PATH=$(npm root -g) node scripts/capture.cjs public/shots",
    "audio": "python3 scripts/make_audio.py public/audio",
    "typecheck": "tsc --noEmit",
    "finish": "python3 scripts/finish.py",
    "still": "remotion still src/index.ts ClaimTracePromo out/still.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
