# Copy to .env and edit. Never commit .env.
# CLAIMTRACE_DB=./data/claimtrace.db
# CLAIMTRACE_HOST=127.0.0.1
# CLAIMTRACE_PORT=8000
# CLAIMTRACE_API_TOKEN=            # required if you bind to anything other than localhost
# CLAIMTRACE_RETENTION_DAYS=       # delete documents older than N days (checked hourly)
# CLAIMTRACE_ALLOW_URL_INGESTION=false
# CLAIMTRACE_LLM_PROVIDER=rules    # rules | ollama | openai
# CLAIMTRACE_LLM_BASE_URL=         # e.g. http://localhost:11434/v1 for Ollama
# CLAIMTRACE_LLM_MODEL=
# CLAIMTRACE_LLM_API_KEY=          # only for hosted providers; documents also need per-document approval
